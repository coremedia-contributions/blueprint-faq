<?xml version="1.0" encoding="ISO-8859-1" ?>
<!--
  FAQ specific document types
-->
<DocumentTypeModel xmlns="http://www.coremedia.com/2008/documenttypes"
                   xmlns:extensions="http://www.coremedia.com/2013/documenttypes-extensions"
                   Name="faq-doctypes"
                   Title="FAQ Document Types">

  <!--- well known grammars -->
  <ImportGrammar Name="coremedia-struct-2008"/>

  <ImportDocType Name="CMTeasable"/>

  <DocType Name="CMFAQ" Parent="CMTeasable">
    <LinkListProperty Name="master" Max="1" LinkType="CMFAQ" Override="true" extensions:weakLink="true"/>
    <XmlProperty Name="questionsAnswers" Grammar="coremedia-struct-2008"/>
  </DocType>

</DocumentTypeModel>
